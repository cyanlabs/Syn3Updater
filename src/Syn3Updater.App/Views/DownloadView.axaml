<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" xmlns:d="using:Cyanlabs.Syn3Updater.Core.Drives" xmlns:m="using:Cyanlabs.Syn3Updater.Core.Models" x:Class="Cyanlabs.Syn3Updater.App.Views.DownloadView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="16" Margin="28,28,28,24">
      <StackPanel Spacing="4">
        <TextBlock Text="{svc:T Main.Downloads}" Classes="title" />
        <TextBlock Text="{Binding Headline}" Classes="muted" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
          <TextBlock Text="{svc:T Settings.DownloadLocation}" Classes="muted" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding DownloadPath}" Classes="muted mono" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding DownloadPath}" />
        </Grid>
      </StackPanel>

      <Border Classes="card" IsVisible="{Binding IsIdle}">
        <TextBlock Text="{svc:T App.Idle}" Classes="muted" HorizontalAlignment="Center" Margin="0,16" />
      </Border>

      <Border Classes="card" IsVisible="{Binding !IsIdle}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding Status}" Classes="section" TextWrapping="Wrap" />
              <TextBlock Text="{Binding CurrentFile}" Classes="muted mono" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding FileCounter}" Classes="label" VerticalAlignment="Top" />
          </Grid>
          <Grid ColumnDefinitions="*,52" ColumnSpacing="10">
            <ProgressBar Value="{Binding FileProgress}" Maximum="100" Height="8" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding FileProgress, StringFormat={}{0}%}" HorizontalAlignment="Right" />
          </Grid>
          <!-- fixed-width slots so changing numbers never move their neighbours: speed and time left on the left, connections on the right -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding IsRunning}">
            <Border x:Name="SpeedChip" Classes="chip" Margin="0" MinWidth="120"><TextBlock Text="{Binding SpeedDisplay}" FontWeight="SemiBold" HorizontalAlignment="Center" /></Border>
            <Border x:Name="EtaChip" Grid.Column="1" Classes="chip" Margin="0" MinWidth="168"><TextBlock Text="{Binding EtaDisplay}" HorizontalAlignment="Center" /></Border>
            <Border x:Name="ConnectionsChip" Grid.Column="3" Classes="chip" Margin="0" MinWidth="148"><TextBlock Text="{Binding ConnectionsDisplay}" Classes="muted" HorizontalAlignment="Center" /></Border>
          </Grid>
          <TextBlock Text="{svc:T Download.TotalDownload}" Classes="label" />
          <Grid ColumnDefinitions="*,52" ColumnSpacing="10">
            <ProgressBar Value="{Binding TotalProgress}" Maximum="100" Height="8" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding TotalProgress, StringFormat={}{0}%}" HorizontalAlignment="Right" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{svc:T App.EjectDrive}" Command="{Binding EjectCommand}" IsEnabled="{Binding CanPressEject}" IsVisible="{Binding CanEject}" />
            <Button Content="{svc:T Download.CancelButton}" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding HasQueue}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{svc:T App.Remaining}" Classes="section" /><TextBlock Grid.Column="1" Text="{Binding PhaseLabel}" Classes="label" VerticalAlignment="Center" /></Grid>
          <ItemsControl ItemsSource="{Binding Queue}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:QueueItem">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Margin="0,5">
                  <Ellipse Classes="dot" Classes.active="{Binding IsActive}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="mono" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{svc:T Download.RequiredTool}" Classes="label" IsVisible="{Binding IsTool}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Size}" Classes="label" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card green" IsVisible="{Binding HasCompleted}">
        <StackPanel Spacing="8">
          <TextBlock Text="{svc:T App.Completed}" Classes="section" />
          <ItemsControl ItemsSource="{Binding Completed}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:QueueItem">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Margin="0,4">
                  <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Foreground="#4cc38a" Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="mono" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                  <TextBlock Grid.Column="2" Text="{svc:T Download.RequiredTool}" Classes="label" IsVisible="{Binding IsTool}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Size}" Classes="label" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="8,4" IsVisible="{Binding !IsIdle}">
      <Expander Header="{svc:T Download.Log}">
        <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Classes="mono" Height="240" FontSize="12" />
      </Expander>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
