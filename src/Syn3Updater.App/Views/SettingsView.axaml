<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" x:Class="Cyanlabs.Syn3Updater.App.Views.SettingsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="760" Spacing="16" Margin="28,28,28,24">
      <StackPanel Spacing="4">
        <TextBlock Text="{svc:T Main.Settings}" Classes="title" />
        <TextBlock Text="{svc:T App.Autosave}" Classes="muted" />
      </StackPanel>

      <!-- ============ profile settings ============ -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="2,10,0,0">
        <Border Classes="ico blue"><PathIcon Data="M18.92,6.01C18.72,5.42 18.16,5 17.5,5H6.5C5.84,5 5.29,5.42 5.08,6.01L3,12V20A1,1 0 0,0 4,21H5A1,1 0 0,0 6,20V19H18V20A1,1 0 0,0 19,21H20A1,1 0 0,0 21,20V12L18.92,6.01M6.5,16A1.5,1.5 0 0,1 5,14.5A1.5,1.5 0 0,1 6.5,13A1.5,1.5 0 0,1 8,14.5A1.5,1.5 0 0,1 6.5,16M17.5,16A1.5,1.5 0 0,1 16,14.5A1.5,1.5 0 0,1 17.5,13A1.5,1.5 0 0,1 19,14.5A1.5,1.5 0 0,1 17.5,16M5,11L6.5,6.5H17.5L19,11H5Z" /></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{svc:T App.ProfileSettings}" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Classes="muted" FontSize="13"><Run Text="{svc:T App.ProfileSettingsDesc}" /><Run Text=" " /><Run Text="{Binding ProfileName}" FontWeight="Bold" Foreground="{DynamicResource Brand}" /></TextBlock>
        </StackPanel>
      </Grid>

      <Border Classes="card blue">
        <StackPanel Spacing="12">
          <TextBlock Text="{svc:T Settings.CarConfiguration}" Classes="section" />
          <TextBlock x:Name="CarWarning" Classes="warning" Text="{Binding WarningText}" />
          <!-- region, version and navigation share one row; the row wraps when the window gets narrow -->
          <WrapPanel ItemSpacing="14" LineSpacing="12">
            <StackPanel Spacing="6" Width="300"><TextBlock Text="{svc:T Settings.Region}" Classes="label" /><ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}" /></StackPanel>
            <StackPanel Spacing="6" Width="190"><TextBlock Text="{svc:T Home.Version}" Classes="label" /><ComboBox x:Name="VersionBox" IsEditable="True" HorizontalAlignment="Stretch" Text="{Binding Version, Mode=TwoWay}" ItemsSource="{Binding KnownVersions}" MaxDropDownHeight="260" PlaceholderText="3.4.20282" ToolTip.Tip="{svc:T Settings.EnterVersion}" /></StackPanel>
            <StackPanel Spacing="6"><TextBlock Text=" " Classes="label" /><CheckBox IsChecked="{Binding Nav}" Content="{svc:T Settings.Navigation}" MinHeight="32" VerticalContentAlignment="Center" /></StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card blue">
        <StackPanel Spacing="12">
          <TextBlock Text="{svc:T Settings.AdvancedOptions}" Classes="section" />
          <TextBlock x:Name="AdvancedWarning" Classes="warning" Text="{svc:T App.AdvancedWarning}" />
          <CheckBox IsChecked="{Binding Advanced}" Content="{svc:T Settings.AdvancedModeToggle}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding Advanced}">
            <StackPanel Spacing="6"><TextBlock Text="{svc:T Settings.InstallMode}" Classes="label" /><ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding Mode}" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{svc:T Settings.My20Mode}" Classes="label" /><ComboBox ItemsSource="{Binding My20Options}" SelectedItem="{Binding My20}" /></StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============ application settings ============ -->
      <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,10,0,2" />
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="2,6,0,0">
        <Border Classes="ico teal"><PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" /></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{svc:T App.AppSettings}" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="{svc:T App.AppSettingsDesc}" Classes="muted" FontSize="13" />
        </StackPanel>
      </Grid>

      <Border Classes="card teal">
        <StackPanel Spacing="12">
          <TextBlock Text="{svc:T Settings.AppOptions}" Classes="section" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <StackPanel Spacing="6"><TextBlock Text="{svc:T Settings.Language}" Classes="label" /><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{svc:T Settings.Theme}" Classes="label" /><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" /></StackPanel>
          </Grid>
          <StackPanel Spacing="6"><TextBlock Text="{svc:T Settings.DownloadLocation}" Classes="label" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding DownloadPath}" /><Button Grid.Column="1" Content="{svc:T App.Choose}" Command="{Binding PickDownloadPathCommand}" /></Grid></StackPanel>
          <StackPanel Spacing="6"><TextBlock Text="{svc:T Settings.LogLocation}" Classes="label" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding LogPath}" /><Button Grid.Column="1" Content="{svc:T App.Choose}" Command="{Binding PickLogPathCommand}" /></Grid></StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <StackPanel Spacing="6"><TextBlock Text="{svc:T Settings.DownloadConnections}" Classes="label" /><ComboBox ItemsSource="{Binding ConnectionOptions}" SelectedItem="{Binding Connections}" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{svc:T Settings.MapKey}" Classes="label" /><TextBox Text="{Binding LicenseKey}" /></StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- actions, bottom right -->
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,6,0,0">
        <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Classes="muted" />
        <Button Grid.Column="1" Content="Reset" Command="{Binding ResetCommand}" />
        <Button Grid.Column="2" Content="{svc:T Settings.Apply}" Classes="accent" Command="{Binding ApplyClickCommand}" MinWidth="130" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
