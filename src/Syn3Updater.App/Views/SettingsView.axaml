<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" x:Class="Cyanlabs.Syn3Updater.App.Views.SettingsView">
  <ScrollViewer>
    <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Stretch">
      <TextBlock Text="{svc:T Main.Settings}" Classes="h1" />

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{svc:T Settings.CarConfiguration}" Classes="h2" Margin="0" />
          <TextBlock Text="{svc:T Settings.EnterRegionNav}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{svc:T Settings.Warning}" Foreground="Firebrick" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{svc:T Settings.Region}" Classes="muted" />
          <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}" />
          <TextBlock Text="{svc:T Settings.EnterVersion}" Classes="muted" />
          <TextBox Text="{Binding Version}" Watermark="3.4.20282" />
          <CheckBox IsChecked="{Binding Nav}" Content="{svc:T Settings.Navigation}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{svc:T Settings.Configuration}" Classes="h2" Margin="0" />
          <TextBlock Text="{svc:T Settings.Language}" Classes="muted" />
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
          <TextBlock Text="{svc:T Settings.Theme}" Classes="muted" />
          <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" />
          <TextBlock Text="{svc:T Settings.DownloadLocation}" Classes="muted" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding DownloadPath}" /><Button Grid.Column="1" Content="..." Command="{Binding PickDownloadPathCommand}" /></Grid>
          <TextBlock Text="{svc:T Settings.LogLocation}" Classes="muted" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding LogPath}" /><Button Grid.Column="1" Content="..." Command="{Binding PickLogPathCommand}" /></Grid>
          <TextBlock Text="{svc:T Settings.DownloadConnections}" Classes="muted" />
          <ComboBox ItemsSource="{Binding ConnectionOptions}" SelectedItem="{Binding Connections}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{svc:T Settings.AdvancedOptions}" Classes="h2" Margin="0" />
          <CheckBox IsChecked="{Binding Advanced}" Content="{svc:T Settings.AdvancedModeToggle}" />
          <StackPanel Spacing="8" IsVisible="{Binding Advanced}">
            <TextBlock Text="{svc:T Settings.InstallMode}" Classes="muted" />
            <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding Mode}" />
            <TextBlock Text="{svc:T Settings.My20Mode}" Classes="muted" />
            <ComboBox ItemsSource="{Binding My20Options}" SelectedItem="{Binding My20}" />
          </StackPanel>
          <TextBlock Text="{svc:T Settings.MapKey}" Classes="muted" />
          <TextBox Text="{Binding LicenseKey}" />
          <TextBlock Text="Ad slot banner image URL" Classes="muted" />
          <TextBox Text="{Binding AdImageUrl}" Watermark="https://.../banner-728x90.png" />
          <TextBlock Text="Ad slot click-through URL" Classes="muted" />
          <TextBox Text="{Binding AdLinkUrl}" />
          <CheckBox IsChecked="{Binding ShowAdSlot}" Content="Show the ad space (placeholder when no banner is set)" />
          <TextBlock Text="CyanLabs API token (or set SYN3_API_TOKEN)" Classes="muted" />
          <TextBox Text="{Binding ApiToken}" PasswordChar="•" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="{svc:T Settings.Apply}" Classes="accent" Command="{Binding ApplyCommand}" />
        <Button Content="Reset" Command="{Binding ResetCommand}" />
        <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
