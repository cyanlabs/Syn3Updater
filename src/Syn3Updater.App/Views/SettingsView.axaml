<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" xmlns:d="using:Cyanlabs.Syn3Updater.Core.Drives" xmlns:m="using:Cyanlabs.Syn3Updater.Core.Models" x:Class="Cyanlabs.Syn3Updater.App.Views.SettingsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="760" Spacing="16" Margin="32,28,32,24">
      <StackPanel Spacing="4">
        <TextBlock Text="{svc:T Main.Settings}" Classes="title" />
        <TextBlock Text="{svc:T App.Autosave}" Classes="muted" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{svc:T Settings.CarConfiguration}" Classes="section" /><Border Grid.Column="1" Classes="chip" Margin="0"><TextBlock Text="{svc:T App.ProfileBased}" /></Border></Grid>
          <TextBlock Text="{svc:T Settings.Warning}" Foreground="{DynamicResource WarnFg}" FontSize="12" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <StackPanel Spacing="6"><TextBlock Text="{svc:T Settings.Region}" Classes="label" /><ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{svc:T Settings.EnterVersion}" Classes="label" /><TextBox Text="{Binding Version}" Watermark="3.4.20282" /></StackPanel>
          </Grid>
          <CheckBox IsChecked="{Binding Nav}" Content="{svc:T Settings.Navigation}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{svc:T Settings.AppOptions}" Classes="section" /><Border Grid.Column="1" Classes="chip" Margin="0"><TextBlock Text="{svc:T App.AppWide}" /></Border></Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <StackPanel Spacing="6"><TextBlock Text="{svc:T Settings.Language}" Classes="label" /><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{svc:T Settings.Theme}" Classes="label" /><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" /></StackPanel>
          </Grid>
          <StackPanel Spacing="6"><TextBlock Text="{svc:T Settings.DownloadLocation}" Classes="label" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding DownloadPath}" /><Button Grid.Column="1" Content="{svc:T App.Choose}" Command="{Binding PickDownloadPathCommand}" /></Grid></StackPanel>
          <StackPanel Spacing="6"><TextBlock Text="{svc:T Settings.LogLocation}" Classes="label" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding LogPath}" /><Button Grid.Column="1" Content="{svc:T App.Choose}" Command="{Binding PickLogPathCommand}" /></Grid></StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <StackPanel Spacing="6"><TextBlock Text="{svc:T Settings.DownloadConnections}" Classes="label" /><ComboBox ItemsSource="{Binding ConnectionOptions}" SelectedItem="{Binding Connections}" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{svc:T Settings.MapKey}" Classes="label" /><TextBox Text="{Binding LicenseKey}" /></StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{svc:T Settings.AdvancedOptions}" Classes="section" /><Border Grid.Column="1" Classes="chip" Margin="0"><TextBlock Text="{svc:T App.ProfileBased}" /></Border></Grid>
          <CheckBox IsChecked="{Binding Advanced}" Content="{svc:T Settings.AdvancedModeToggle}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding Advanced}">
            <StackPanel Spacing="6"><TextBlock Text="{svc:T Settings.InstallMode}" Classes="label" /><ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding Mode}" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{svc:T Settings.My20Mode}" Classes="label" /><ComboBox ItemsSource="{Binding My20Options}" SelectedItem="{Binding My20}" /></StackPanel>
          </Grid>
        </StackPanel>
      </Border>


      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
        <Button Content="{svc:T Settings.Apply}" Classes="accent" Command="{Binding ApplyClickCommand}" MinWidth="130" />
        <Button Grid.Column="1" Content="Reset" Command="{Binding ResetCommand}" />
        <TextBlock Grid.Column="2" Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Classes="muted" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
