<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" xmlns:m="using:Cyanlabs.Syn3Updater.Core.Models" x:Class="Cyanlabs.Syn3Updater.App.Views.AboutView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="760" Spacing="16" Margin="32,28,32,24">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource Brand}"><TextBlock Text="S3" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="{svc:T About.AboutTitle}" Classes="title" /><TextBlock Text="{Binding Version}" Classes="muted" /></StackPanel>
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="{svc:T About.DocumentationTitle}" Classes="section" />
          <TextBlock Text="{svc:T About.Documentation}" TextWrapping="Wrap" Classes="muted" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="{svc:T About.DocumentationButton}" Command="{Binding OpenDocsCommand}" Classes="accent" />
            <Button Content="{svc:T About.ForumButton}" Command="{Binding OpenForumCommand}" />
            <Button Content="{svc:T About.FHubButton}" Command="{Binding OpenFHubCommand}" />
            <Button Content="{svc:T About.DonateButton}" Command="{Binding OpenDonateCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="{svc:T About.DisclaimerTitle}" Classes="section" />
          <TextBlock Text="{svc:T About.Disclaimer}" TextWrapping="Wrap" />
          <TextBlock Text="{svc:T About.Endorsed}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
          <CheckBox IsChecked="{Binding Accepted}" Content="{svc:T About.DisclaimerAgreement}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
