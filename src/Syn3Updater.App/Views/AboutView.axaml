<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" x:Class="Cyanlabs.Syn3Updater.App.Views.AboutView">
  <ScrollViewer>
    <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Stretch">
      <TextBlock Text="{svc:T About.AboutTitle}" Classes="h1" />
      <TextBlock Text="{Binding Version}" Classes="muted" />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{svc:T About.DocumentationTitle}" Classes="h2" Margin="0" />
          <TextBlock Text="{svc:T About.Documentation}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{svc:T About.DocumentationButton}" Command="{Binding OpenDocsCommand}" />
            <Button Content="{svc:T About.ForumButton}" Command="{Binding OpenForumCommand}" />
            <Button Content="{svc:T About.FHubButton}" Command="{Binding OpenFHubCommand}" />
            <Button Content="{svc:T About.DonateButton}" Command="{Binding OpenDonateCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{svc:T About.DisclaimerTitle}" Classes="h2" Margin="0" />
          <TextBlock Text="{svc:T About.Disclaimer}" TextWrapping="Wrap" />
          <TextBlock Text="{svc:T About.Endorsed}" TextWrapping="Wrap" Classes="muted" />
          <CheckBox IsChecked="{Binding Accepted}" Content="{svc:T About.DisclaimerAgreement}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
