<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels"
             x:Class="Cyanlabs.Syn3Updater.App.Views.LogsView">
  <Grid RowDefinitions="Auto,*" Margin="28,28,28,16" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="{svc:T Main.Logs}" Classes="title" />
        <TextBlock Text="{Binding Path}" Classes="muted mono" FontSize="12" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Command="{Binding RefreshCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="15" Height="15" /><TextBlock Text="{svc:T Home.Refresh}" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Content="{svc:T Logs.OpenFolder}" Command="{Binding OpenFolderCommand}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="290,*" ColumnSpacing="16">
      <!-- list of logs -->
      <Border Classes="card" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="8,2,8,10" Classes="label"><Run Text="{svc:T Logs.SavedLogs}" /><Run Text="  " /><Run Text="{Binding FileCountText}" /></TextBlock>
          <TextBlock DockPanel.Dock="Bottom" Text="{svc:T Logs.NoSaved}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" Margin="10,8" IsVisible="{Binding !HasSavedLogs}" />
          <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:LogFile">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4">
                  <Border Width="34" Height="34" CornerRadius="9" Background="{Binding IconBackground}"><PathIcon Data="{Binding IconData}" Foreground="{Binding IconBrush}" Width="18" Height="18" /></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Classes="label" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- viewer -->
      <Border Grid.Column="1" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Margin="18,14,18,8" ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding ViewTitle}" Classes="section" TextTrimming="CharacterEllipsis" />
              <WrapPanel ItemSpacing="8" LineSpacing="4">
                <TextBlock Text="{Binding ViewMeta}" Classes="label" VerticalAlignment="Center" />
                <Border Classes="chip" Margin="0" Padding="8,1" Background="#33ef6b62" IsVisible="{Binding ErrorCount}"><TextBlock Foreground="#ef6b62" FontSize="11.5"><Run Text="{Binding ErrorsText}" /></TextBlock></Border>
                <Border Classes="chip" Margin="0" Padding="8,1" Background="#33f0a43c" IsVisible="{Binding WarningCount}"><TextBlock Foreground="#f0a43c" FontSize="11.5"><Run Text="{Binding WarningsText}" /></TextBlock></Border>
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Content="{svc:T App.Copy}" Command="{Binding CopyCommand}" />
              <Button Content="{svc:T Utility.UploadLog}" Command="{Binding UploadCommand}" />
              <Button Content="{svc:T Profiles.DeleteProfile}" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="18,0,18,10" ColumnSpacing="12">
            <TextBox Text="{Binding Search}" Watermark="{svc:T Logs.Search}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding ErrorsOnly}" Content="{svc:T Logs.ErrorsOnly}" VerticalAlignment="Center" />
          </Grid>
          <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
            <ListBox ItemsSource="{Binding Lines}" Background="Transparent" Padding="6" SelectionMode="Single">
              <ListBox.Styles>
                <Style Selector="ListBoxItem"><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="8,2" /></Style>
                <Style Selector="SelectableTextBlock.err"><Setter Property="Foreground" Value="#ef6b62" /></Style>
                <Style Selector="SelectableTextBlock.warn"><Setter Property="Foreground" Value="#f0a43c" /></Style>
                <Style Selector="SelectableTextBlock.ok"><Setter Property="Foreground" Value="#4cc38a" /></Style>
                <Style Selector="SelectableTextBlock.dbg"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:LogLine">
                  <SelectableTextBlock Text="{Binding Text}" Classes="mono" Classes.err="{Binding IsError}" Classes.warn="{Binding IsWarning}" Classes.ok="{Binding IsSuccess}" Classes.dbg="{Binding IsDebug}" FontSize="12" TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
