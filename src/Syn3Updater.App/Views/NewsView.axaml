<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" xmlns:m="using:Cyanlabs.Syn3Updater.Core.Models" x:Class="Cyanlabs.Syn3Updater.App.Views.NewsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="820" Spacing="14" Margin="32,28,32,24">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{svc:T Main.News}" Classes="title" /><Button Grid.Column="1" Content="{svc:T Home.Refresh}" Command="{Binding LoadCommand}" /></Grid>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Important}">
        <ItemsControl.ItemTemplate><DataTemplate DataType="m:Notice">
          <Border Classes="banner" Margin="0,0,0,10"><StackPanel Spacing="4">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource WarnFg}" />
            <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap" />
          </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Other}">
        <ItemsControl.ItemTemplate><DataTemplate DataType="m:Notice">
          <Border Classes="card" Margin="0,0,0,10"><StackPanel Spacing="4">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap" Classes="muted" />
          </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{svc:T News.Changelog}" Classes="section" Margin="0,8,0,0" />
      <ItemsControl ItemsSource="{Binding Changelogs}">
        <ItemsControl.ItemTemplate><DataTemplate DataType="m:Changelog">
          <Border Classes="card" Margin="0,0,0,10"><StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10"><Border Classes="badge"><TextBlock Text="{Binding Version}" /></Border><TextBlock Text="{Binding Date}" Classes="label" VerticalAlignment="Center" /></StackPanel>
            <SelectableTextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Classes="muted" />
          </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
