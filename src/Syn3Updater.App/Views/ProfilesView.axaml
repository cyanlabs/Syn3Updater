<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" x:Class="Cyanlabs.Syn3Updater.App.Views.ProfilesView">
  <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Text="{svc:T Main.Profiles}" Classes="h1" />
    <Border Classes="card">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{svc:T Profiles.CurrentProfile}" Classes="muted" /><TextBlock Text="{Binding Current}" FontWeight="SemiBold" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" MaxHeight="220" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{svc:T Profiles.SelectProfile}" Command="{Binding SelectCommand}" />
          <Button Content="{svc:T Profiles.DeleteProfile}" Command="{Binding DeleteCommand}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding RenameTo}" Watermark="{svc:T Profiles.RenameProfile}" />
          <Button Grid.Column="1" Content="{svc:T Profiles.Rename}" Command="{Binding RenameCommand}" />
        </Grid>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="{svc:T Profiles.NewProfile}" Classes="muted" />
        <TextBox Text="{Binding NewName}" />
        <Button Content="{svc:T Profiles.CreateAndSet}" Command="{Binding CreateCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
