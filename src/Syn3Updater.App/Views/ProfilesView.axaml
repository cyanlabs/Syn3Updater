<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" xmlns:m="using:Cyanlabs.Syn3Updater.Core.Models" x:Class="Cyanlabs.Syn3Updater.App.Views.ProfilesView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="640" Spacing="16" Margin="32,28,32,24">
      <StackPanel Spacing="4">
        <TextBlock Text="{svc:T Main.Profiles}" Classes="title" />
        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{svc:T Profiles.CurrentProfile}" Classes="muted" /><Border Classes="badge"><TextBlock Text="{Binding Current}" /></Border></StackPanel>
      </StackPanel>
      <Border Classes="card">
        <StackPanel Spacing="12">
          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" MaxHeight="240" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{svc:T Profiles.SelectProfile}" Command="{Binding SelectCommand}" Classes="accent" />
            <Button Content="{svc:T Profiles.DeleteProfile}" Command="{Binding DeleteCommand}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding RenameTo}" Watermark="{svc:T Profiles.RenameProfile}" />
            <Button Grid.Column="1" Content="{svc:T Profiles.Rename}" Command="{Binding RenameCommand}" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{svc:T Profiles.NewProfile}" Classes="section" />
          <TextBox Text="{Binding NewName}" />
          <Button Content="{svc:T Profiles.CreateAndSet}" Command="{Binding CreateCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
