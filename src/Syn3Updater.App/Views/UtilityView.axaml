<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" xmlns:ctl="using:Cyanlabs.Syn3Updater.App.Controls" xmlns:d="using:Cyanlabs.Syn3Updater.Core.Drives" xmlns:m="using:Cyanlabs.Syn3Updater.Core.Models" x:Class="Cyanlabs.Syn3Updater.App.Views.UtilityView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Spacing="16" Margin="28,28,28,24">
      <TextBlock Text="{svc:T Main.Utility}" Classes="title" />

      <!-- shared destination -->
      <Border Classes="card teal">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="ico teal"><PathIcon Data="M15,7V11H16V13H13V5H15L12,1L9,5H11V13H8V10.93C8.7,10.56 9.2,9.85 9.2,9C9.2,7.8 8.2,6.8 7,6.8C5.8,6.8 4.8,7.8 4.8,9C4.8,9.85 5.3,10.56 6,10.93V13A2,2 0 0,0 8,15H11V18.05C10.3,18.4 9.8,19.1 9.8,20C9.8,21.1 10.7,22 11.8,22C12.9,22 13.8,21.1 13.8,20C13.8,19.1 13.3,18.4 12.6,18.05V15H16A2,2 0 0,0 18,13V11H19V7H15Z" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"><TextBlock Text="{svc:T Utility.SelectUSBDrive}" Classes="section" /></StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" MinHeight="48" PlaceholderText="{svc:T Utility.SelectUSBDrive}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="d:DriveInfoModel">
                  <StackPanel Margin="0,4"><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding Detail}" Classes="label" /></StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" MinHeight="48"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="16" Height="16" /><TextBlock Text="{svc:T Home.Refresh}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Grid.Column="2" Command="{Binding EjectSelectedCommand}" IsEnabled="{Binding CanEjectSelected}" ToolTip.Tip="{svc:T App.EjectDrive}" MinHeight="48" MinWidth="48"><PathIcon Data="M5,17H19V19H5V17M12,5L5.33,15H18.67L12,5Z" Width="18" Height="18" /></Button>
          </Grid>
          <TextBlock Text="{Binding DriveInfo}" Classes="muted" />
        </StackPanel>
      </Border>

      <!-- interrogator -->
      <Border Classes="card blue">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="ico blue"><PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,9V3.5L18.5,9H13Z" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"><TextBlock Text="{svc:T Utility.CreateLogTitle}" Classes="section" /><TextBlock Text="{svc:T Utility.CreateLogDesc}" Classes="muted" TextWrapping="Wrap" FontSize="13" /></StackPanel>
          </Grid>
          <!-- three steps, three boxes: 1 prepare the drive, 2 use it in the car (nothing to press), 3 open the log it produced and upload it -->
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border x:Name="Step1" Classes="card blue" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="{svc:T Utility.CreateLogStep1}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Button Classes="prep teal" Content="{Binding PrepareLabel}" ToolTip.Tip="{Binding PrepareTip}" ToolTip.ShowOnDisabled="True" HorizontalAlignment="Left" Command="{Binding CreateLogUsbCommand}" IsEnabled="{Binding CanPrepare}" />
              </StackPanel>
            </Border>
            <Border x:Name="Step2" Grid.Column="1" Classes="card blue" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="{svc:T App.Step2Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Spacing="12" Margin="0,2,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource Brand}" VerticalAlignment="Top" Margin="0,6,0,0" />
                  <TextBlock Grid.Column="1" Text="{svc:T App.Step2a}" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource Brand}" VerticalAlignment="Top" Margin="0,6,0,0" />
                  <TextBlock Grid.Column="1" Text="{svc:T App.Step2b}" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource Brand}" VerticalAlignment="Top" Margin="0,6,0,0" />
                  <TextBlock Grid.Column="1" Text="{svc:T App.Step2c}" TextWrapping="Wrap" />
                </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="Step3" Grid.Column="2" Classes="card blue" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="{svc:T App.Step3Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Sync_XXXXXXXX_VIN.xml" Classes="muted mono" FontSize="12" />
                <Button Content="{svc:T App.OpenLog}" Command="{Binding ParseLogCommand}" HorizontalAlignment="Left" />
                <Button Classes="prep teal" ToolTip.Tip="{Binding UploadTip}" ToolTip.ShowOnDisabled="True" Content="{svc:T Utility.UploadLog}" Command="{Binding UploadLogCommand}" IsEnabled="{Binding HasLog}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- the result: the verdict first, then the facts, then the long lists folded away -->
          <StackPanel Spacing="14" IsVisible="{Binding HasLog}">
            <Border Background="{Binding ResBackground}" CornerRadius="12" Padding="16,14">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <PathIcon Data="M21,11C21,16.55 17.16,21.74 12,23C6.84,21.74 3,16.55 3,11V5L12,1L21,5V11M12,21C15.75,20 19,15.54 19,11.22V6.3L12,3.18L5,6.3V11.22C5,15.54 8.25,20 12,21Z" Foreground="{Binding ResBrush}" Width="28" Height="28" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ResVerdict}" Foreground="{Binding ResBrush}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Facts}">
              <!-- as many columns as fit, each tile stretched so the rows always fill the column -->
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><ctl:AdaptiveColumns MinItemWidth="240" Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:FactItem">
                  <Border Classes="card" Padding="14,10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Label}" Classes="label" />
                      <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander Header="{svc:T App.Partitions}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="16" Margin="4,8,4,4">
                <ItemsControl ItemsSource="{Binding PartitionRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PartitionRow">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Path}" Classes="mono" FontSize="12.5" />
                        <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="label" VerticalAlignment="Center" />
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Value="{Binding Used}" Height="4" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="8">
                  <TextBlock Text="{svc:T Utility.PackagesTitle}" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding PackageRows}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate><Border Classes="chip" Margin="0,0,6,6"><TextBlock Text="{Binding}" Classes="mono" /></Border></DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Expander>

            <Expander Header="{svc:T App.AsBuilt}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <ItemsControl ItemsSource="{Binding AsBuiltRows}" Margin="4,8,4,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:AsBuiltRow">
                    <Grid ColumnDefinitions="64,*" Margin="0,0,0,4">
                      <TextBlock Text="{Binding Id}" Classes="mono" FontSize="12.5" Foreground="{DynamicResource Brand}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12.5" TextWrapping="Wrap" Opacity="{Binding Opacity}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{svc:T Utility.CopyAsBuilt}" Command="{Binding CopyAsBuiltCommand}" />
              <Button Content="{svc:T Utility.ViewAsBuilt}" Command="{Binding ViewAsBuiltCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- MEM_ERR tools -->
      <Border Classes="card amber">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="ico amber"><PathIcon Data="M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L9,6L6,9L1.6,4.7C0.4,7.1 0.9,10.1 2.9,12.1C4.8,14 7.5,14.5 9.8,13.6L18.9,22.7C19.3,23.1 19.9,23.1 20.3,22.7L22.6,20.4C23.1,20 23.1,19.3 22.7,19Z" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"><TextBlock Text="{svc:T App.MemErr}" Classes="section" /><TextBlock Text="{svc:T Utility.TroubleshootDesc}" Classes="muted" TextWrapping="Wrap" FontSize="13" /></StackPanel>
          </Grid>
            <Button Grid.Column="1" Classes="link" Content="{svc:T App.MoreInformation}" Command="{Binding TroubleshootCommand}" VerticalAlignment="Top" />
          </Grid>
          <UniformGrid Columns="2">
            <Border Margin="0,0,6,12"><Border Classes="card lime" Padding="16"><StackPanel Spacing="10">
              <Border Classes="ico lime"><PathIcon Data="M19.36,2.72L20.78,4.14L15.06,9.85C16.13,11.39 16.28,13.24 15.38,14.44L9.06,8.12C10.26,7.22 12.11,7.37 13.65,8.44L19.36,2.72M5.93,17.57C3.92,15.56 2.69,13.16 2.35,10.92L7.23,8.83L14.67,16.27L12.58,21.15C10.34,20.81 7.94,19.58 5.93,17.57Z" /></Border>
              <TextBlock Text="{svc:T Utility.RWDataCleanerTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{svc:T Utility.RWDataCleanerDesc}" Classes="muted" TextWrapping="Wrap" FontSize="13" />
              <Button Classes="prep lime" Content="{Binding PrepareLabel}" ToolTip.Tip="{Binding PrepareTip}" ToolTip.ShowOnDisabled="True" HorizontalAlignment="Left"  Command="{Binding RwDataCleanerCommand}" IsEnabled="{Binding CanPrepare}" />
            </StackPanel></Border></Border>
            <Border Margin="6,0,0,12"><Border Classes="card pink" Padding="16"><StackPanel Spacing="10">
              <Border Classes="ico pink"><PathIcon Data="M12,3V13.55C11.41,13.21 10.73,13 10,13A4,4 0 0,0 6,17A4,4 0 0,0 10,21A4,4 0 0,0 14,17V7H18V3H12Z" /></Border>
              <TextBlock Text="{svc:T Utility.GracenotesRemovalTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{svc:T Utility.GracenotesRemovalDesc}" Classes="muted" TextWrapping="Wrap" FontSize="13" />
              <Button Classes="prep pink" Content="{Binding PrepareLabel}" ToolTip.Tip="{Binding PrepareTip}" ToolTip.ShowOnDisabled="True" HorizontalAlignment="Left"  Command="{Binding GracenotesCommand}" IsEnabled="{Binding CanPrepare}" />
            </StackPanel></Border></Border>
            <Border Margin="0,0,6,12"><Border Classes="card purple" Padding="16"><StackPanel Spacing="10">
              <Border Classes="ico purple"><PathIcon Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z" /></Border>
              <TextBlock Text="{svc:T Utility.VoiceShrinkerTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{svc:T Utility.VoiceShrinkerDesc}" Classes="muted" TextWrapping="Wrap" FontSize="13" />
              <Button Classes="prep purple" Content="{Binding PrepareLabel}" ToolTip.Tip="{Binding PrepareTip}" ToolTip.ShowOnDisabled="True" HorizontalAlignment="Left"  Command="{Binding SmallVoiceCommand}" IsEnabled="{Binding CanPrepare}" />
            </StackPanel></Border></Border>
            <Border Margin="6,0,0,12"><Border Classes="card red" Padding="16"><StackPanel Spacing="10">
              <Border Classes="ico red"><PathIcon Data="M9,4H15V12H19.84L12,19.84L4.16,12H9V4Z" /></Border>
              <TextBlock Text="{svc:T Utility.DowngradeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{svc:T Utility.DowngradeDesc}" Classes="muted" TextWrapping="Wrap" FontSize="13" />
              <Button Classes="prep red" Content="{Binding PrepareLabel}" ToolTip.Tip="{Binding PrepareTip}" ToolTip.ShowOnDisabled="True" HorizontalAlignment="Left"  Command="{Binding DowngradeCommand}" IsEnabled="{Binding CanPrepare}" />
            </StackPanel></Border></Border>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- Sync 2.2 upgrade: its own section -->
      <Border Classes="card green">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
          <Border Classes="ico green" VerticalAlignment="Top"><PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" /></Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{svc:T App.Upgrade22Title}" Classes="section" /><TextBlock Text="{svc:T App.Upgrade22Desc}" Classes="muted" TextWrapping="Wrap" FontSize="13" /></StackPanel>
          <Button Classes="prep green" Grid.Column="2" Content="{Binding PrepareLabel}" ToolTip.Tip="{Binding PrepareTip}" ToolTip.ShowOnDisabled="True" VerticalAlignment="Center"  Command="{Binding Upgrade22Command}" IsEnabled="{Binding CanPrepare}" />
        </Grid>
      </Border>

      <!-- MY20 check -->
      <Border Classes="card purple">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="ico purple"><PathIcon Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"><TextBlock Text="{svc:T Utility.My20CheckTitle}" Classes="section" /><TextBlock Text="{svc:T Utility.My20CheckDesc}" Classes="muted" TextWrapping="Wrap" FontSize="13" /></StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding ApimModelInput}" Watermark="####-14G371-###" />
            <Button Grid.Column="1" Content="{svc:T App.Check}" Command="{Binding CheckMy20Command}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
