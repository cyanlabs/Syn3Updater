<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" xmlns:d="using:Cyanlabs.Syn3Updater.Core.Drives" xmlns:ctl="using:Cyanlabs.Syn3Updater.App.Controls" xmlns:m="using:Cyanlabs.Syn3Updater.Core.Models" x:Class="Cyanlabs.Syn3Updater.App.Views.HomeView">
  <UserControl.Styles>
    <!-- bottom bar, wide: [what will happen] [MY20] [Download only] [Start] on one row -->
    <Style Selector="Grid.bar > Grid#ModeInfo"><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="0" /></Style>
    <Style Selector="Grid.bar > Border#My20Badge"><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="1" /></Style>
    <Style Selector="Grid.bar > Button#DownloadOnlyButton"><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="2" /></Style>
    <Style Selector="Grid.bar > Button#StartButton"><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.Column" Value="3" /></Style>
    <!-- narrow: what will happen gets the whole first row so none of it is cut off; MY20 and the buttons share the second -->
    <Style Selector="Grid.bar.compact > Grid#ModeInfo"><Setter Property="Grid.ColumnSpan" Value="4" /></Style>
    <Style Selector="Grid.bar.compact > Border#My20Badge"><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="0" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
    <Style Selector="Grid.bar.compact > Button#DownloadOnlyButton"><Setter Property="Grid.Row" Value="1" /></Style>
    <Style Selector="Grid.bar.compact > Button#StartButton"><Setter Property="Grid.Row" Value="1" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="880" Spacing="16" Margin="28,28,28,24">

        <!-- header: title + your current car configuration as chips -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="10">
            <TextBlock Text="{svc:T Main.Home}" Classes="title" />
            <ItemsControl ItemsSource="{Binding ConfigItems}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConfigItem">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,8">
                    <TextBlock Text="{Binding Label, StringFormat={}{0}:}" Classes="muted" VerticalAlignment="Center" FontSize="13" />
                    <Border Classes="chip" Margin="0"><TextBlock Text="{Binding Value}" /></Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Button Grid.Column="1" Content="{svc:T App.Edit}" Command="{Binding EditConfigCommand}" VerticalAlignment="Top" />
        </Grid>

        <!-- 1. destination -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="step"><TextBlock Text="1" /></Border>
              <TextBlock Text="{svc:T Home.SelectUSBDrive}" Classes="section" VerticalAlignment="Center" />
              <Button x:Name="UsbHelp" Classes="help" ToolTip.Tip="{svc:T Home.RecommendedUSBFlashDriveTitle}">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Width="340" Spacing="8" Margin="4">
                      <TextBlock Text="{svc:T Home.RecommendedUSBFlashDriveTitle}" FontWeight="SemiBold" />
                      <StackPanel Spacing="6">
                        <TextBlock Text="{svc:T Home.RecommendedUSBFlashDriveNonNav}" TextWrapping="Wrap" />
                        <TextBlock Text="{svc:T Home.RecommendedUSBFlashDriveNA}" TextWrapping="Wrap" />
                        <TextBlock Text="{svc:T Home.RecommendedUSBFlashDriveEU}" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Text="{svc:T App.UsbFormatNote}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
                <PathIcon Data="M11,18H13V16H11V18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,6A4,4 0 0,0 8,10H10A2,2 0 0,1 12,8A2,2 0 0,1 14,10C14,12 11,11.75 11,15H13C13,12.75 16,12.5 16,10A4,4 0 0,0 12,6Z" />
              </Button>
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" MinHeight="48" PlaceholderText="{svc:T Home.SelectUSBDrive}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="d:DriveInfoModel">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                      <PathIcon Data="M15,7V11H16V13H13V5H15L12,1L9,5H11V13H8V10.93C8.7,10.56 9.2,9.85 9.2,9C9.2,7.8 8.2,6.8 7,6.8C5.8,6.8 4.8,7.8 4.8,9C4.8,9.85 5.3,10.56 6,10.93V13A2,2 0 0,0 8,15H11V18.05C10.3,18.4 9.8,19.1 9.8,20C9.8,21.1 10.7,22 11.8,22C12.9,22 13.8,21.1 13.8,20C13.8,19.1 13.3,18.4 12.6,18.05V15H16A2,2 0 0,0 18,13V11H19V7H15Z" Width="18" Height="18" Foreground="{DynamicResource Brand}" IsVisible="{Binding !IsFolder}" />
                      <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" Width="18" Height="18" Foreground="{DynamicResource Brand}" IsVisible="{Binding IsFolder}" />
                      <StackPanel><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding Detail}" Classes="label" TextTrimming="CharacterEllipsis" MaxWidth="400" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" /></StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Command="{Binding RefreshDrivesCommand}" ToolTip.Tip="{svc:T Home.Refresh}" MinHeight="48" MinWidth="48">
                <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="18" Height="18" />
              </Button>
              <Button Grid.Column="2" Command="{Binding EjectSelectedCommand}" IsEnabled="{Binding CanEjectSelected}" ToolTip.Tip="{svc:T App.EjectDrive}" MinHeight="48" MinWidth="48"><PathIcon Data="M5,17H19V19H5V17M12,5L5.33,15H18.67L12,5Z" Width="18" Height="18" /></Button>
            </Grid>
            <TextBlock Text="{svc:T App.NoDrives}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding NoDrives}" />
            <TextBlock Text="{Binding DriveInfo}" Classes="muted" />
          </StackPanel>
        </Border>

        <!-- 2. what to install -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10"><Border Classes="step"><TextBlock Text="2" /></Border><TextBlock Text="{svc:T App.ChooseVersion}" Classes="section" VerticalAlignment="Center" /></StackPanel>
            <Grid ColumnDefinitions="130,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{svc:T Home.Region}" VerticalAlignment="Center" Classes="muted" />
                <Button x:Name="RegionHelp" Classes="help" ToolTip.Tip="{svc:T App.RegionsTitle}">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                      <StackPanel Width="380" Spacing="10" Margin="4">
                        <TextBlock Text="{svc:T App.RegionsTitle}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Regions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="m:Region">
                              <Grid ColumnDefinitions="52,*" Margin="0,3">
                                <Border Classes="chip" Margin="0" HorizontalAlignment="Left" Padding="9,2"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" /></Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{svc:T App.RegionsNote}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                  <PathIcon Data="M11,18H13V16H11V18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,6A4,4 0 0,0 8,10H10A2,2 0 0,1 12,8A2,2 0 0,1 14,10C14,12 11,11.75 11,15H13C13,12.75 16,12.5 16,10A4,4 0 0,0 12,6Z" />
                </Button>
              </StackPanel>
              <ComboBox x:Name="RegionBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}" PlaceholderText="{svc:T App.SelectRegion}" />
              <TextBlock Grid.Row="1" Text="{svc:T Home.NewVersion}" VerticalAlignment="Center" Classes="muted" />
              <ComboBox x:Name="ReleaseBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" PlaceholderText="{svc:T App.SelectVersion}" />
              <TextBlock Grid.Row="2" Text="{svc:T Home.MapVersion}" VerticalAlignment="Center" Classes="muted" />
              <!-- ESN state per map: a lock (pre-MY20 only) or an open lock (any unit); a map the release / MY20 setting does not allow is dimmed and cannot be picked -->
              <ComboBox x:Name="MapBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding MapVersions}" SelectedItem="{Binding SelectedMap}" PlaceholderText="{svc:T App.SelectMaps}">
                <ComboBox.Styles>
                  <Style Selector="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding IsSelectable}" /></Style>
                </ComboBox.Styles>
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:MapItem">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                      <PathIcon Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" Width="16" Height="16" Foreground="{Binding LockBrush}" IsVisible="{Binding IsLocked}" />
                      <PathIcon Data="M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H15V6A3,3 0 0,0 12,3A3,3 0 0,0 9,6H7A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17Z" Width="16" Height="16" Foreground="#4cc38a" IsVisible="{Binding IsUnlocked}" />
                      <StackPanel>
                        <TextBlock Text="{Binding Display}" />
                        <TextBlock Text="{Binding Detail}" Classes="label" TextTrimming="CharacterEllipsis" MaxWidth="460" IsVisible="{Binding HasDetail}" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Loading}" Height="4" />

          </StackPanel>
        </Border>

        <!-- release notes: highlighted so they are not missed -->
        <Border Classes="callout" IsVisible="{Binding HasNotes}">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" Foreground="{DynamicResource Brand}" Width="20" Height="20" />
              <TextBlock Text="{svc:T App.ReleaseNotes}" FontWeight="SemiBold" Foreground="{DynamicResource Brand}" VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled"><ctl:MarkdownText Text="{Binding Notes}" FontSize="13.5" /></ScrollViewer>
            <Button Content="{svc:T Home.FeedbackButton}" Command="{Binding OpenFeedbackCommand}" IsVisible="{Binding HasFeedback}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <!-- 3. packages -->
        <Border Classes="card" IsVisible="{Binding HasPackages}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel Orientation="Horizontal" Spacing="10"><Border Classes="step"><TextBlock Text="3" /></Border><TextBlock Text="{svc:T Home.SelectPackages}" Classes="section" VerticalAlignment="Center" /></StackPanel>
              <Button Grid.Column="1" Classes="link" Content="{svc:T App.SelectAll}" Command="{Binding SelectAllCommand}" />
              <Button Grid.Column="2" Classes="link" Content="{svc:T App.SelectNone}" Command="{Binding SelectNoneCommand}" />
            </Grid>
            <TextBlock Text="{Binding SelectionSummary}" Classes="muted" FontSize="13" />
            <ItemsControl ItemsSource="{Binding Packages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PackageRow">
                  <Button Classes="tile" Classes.selected="{Binding Selected}" Command="{Binding ToggleCommand}" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="14">
                      <Border Width="44" Height="44" CornerRadius="12" Background="{Binding IconBackground}">
                        <PathIcon Data="{Binding IconData}" Foreground="{Binding IconBrush}" Width="22" Height="22" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Classes="label" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="help" Command="{Binding OpenInfoCommand}" IsVisible="{Binding HasInfo}" ToolTip.Tip="{svc:T Home.PackageInfo}" AutomationProperties.Name="{svc:T Home.PackageInfo}">
                        <PathIcon Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" />
                      </Button>
                      <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="label" VerticalAlignment="Center" MinWidth="64" TextAlignment="Right" />
                      <CheckBox Grid.Column="4" IsChecked="{Binding Selected}" IsHitTestVisible="False" MinWidth="0" Padding="0" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- sticky action bar: what will happen + Start -->
    <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="28,12">
      <Grid x:Name="BarGrid" Classes="bar" ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
        <Grid x:Name="ModeInfo" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
          <Border Width="40" Height="40" CornerRadius="12" Background="{Binding ModeBackground}" IsVisible="{Binding HasMode}">
            <PathIcon Data="{Binding ModeIcon}" Foreground="{Binding ModeBrush}" Width="20" Height="20" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" IsVisible="{Binding HasMode}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding ModeTitle}" FontWeight="SemiBold" FontSize="15" Foreground="{Binding ModeBrush}" />
              <Border Classes="chip" Margin="0" Padding="8,1" IsVisible="{Binding ModeIsForced}"><TextBlock Text="{svc:T Home.InstallModeForced}" FontSize="11" /></Border>
            </StackPanel>
            <TextBlock Text="{Binding ModeDescription}" Classes="label" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModeDescription}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="link" Content="{svc:T App.LearnMore}" Command="{Binding OpenInstructionsCommand}" IsVisible="{Binding HasMode}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" IsVisible="{Binding !HasMode}">
            <TextBlock Text="{svc:T Home.InstallMode}" Classes="label" />
            <TextBlock Text="{svc:T App.NoMode}" Classes="muted" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
        <!-- MY20 protection decides which install modes are allowed, so it sits next to the mode it affects, with a colour and a shield: green = on, blue = auto-detect, amber = off -->
        <Border x:Name="My20Badge" Background="{Binding My20Background}" CornerRadius="10" Padding="10,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{Binding My20Icon}" Foreground="{Binding My20Brush}" Width="16" Height="16" />
            <TextBlock Text="{Binding My20Label}" Foreground="{Binding My20Brush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Button x:Name="DownloadOnlyButton" Content="{svc:T Home.StartDownloadOnly}" Command="{Binding DownloadOnlyCommand}" IsEnabled="{Binding DownloadOnlyEnabled}" MinHeight="40" />
        <Button x:Name="StartButton" Content="{svc:T Home.StartButton}" Classes="accent" Command="{Binding StartCommand}" IsEnabled="{Binding StartEnabled}" MinWidth="120" MinHeight="40" HorizontalContentAlignment="Center" FontWeight="SemiBold" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
