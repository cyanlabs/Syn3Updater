<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels"
        x:Class="Cyanlabs.Syn3Updater.App.Views.MainWindow"
        Title="{Binding WindowTitle}" Width="1120" Height="800" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="NavItem" DataType="vm:PageViewModel">
      <Button Classes="nav" Classes.active="{Binding IsActive}" ToolTip.Tip="{Binding Title}"
              Command="{Binding $parent[Window].DataContext.NavigateCommand}" CommandParameter="{Binding}">
        <Grid ColumnDefinitions="48,*">
          <PathIcon Data="{Binding IconData}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                     IsVisible="{Binding $parent[Window].DataContext.SidebarExpanded}" />
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Grid ColumnDefinitions="Auto,*" >
    <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0"
            Width="{Binding SidebarWidth}">
      <DockPanel Margin="0,14,0,12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="16,0,8,18">
          <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Brand}">
            <TextBlock Text="S3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel IsVisible="{Binding SidebarExpanded}" VerticalAlignment="Center">
            <TextBlock Text="Syn3 Updater" FontWeight="SemiBold" />
            <TextBlock Text="CyanLabs" Classes="label" />
          </StackPanel>
        </StackPanel>
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding BottomPages}" ItemTemplate="{StaticResource NavItem}" />
        <ItemsControl ItemsSource="{Binding TopPages}" ItemTemplate="{StaticResource NavItem}" />
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="*,Auto">
      <ContentControl Grid.Row="0" Content="{Binding Current}" />

      <!-- Ad space: sponsor banner image + link (Settings > Sponsor banner), or a placeholder -->
      <Border Grid.Row="1" IsVisible="{Binding AdVisible}" Margin="32,0,32,12" Height="64" MaxWidth="728" HorizontalAlignment="Stretch"
              Classes="card" Padding="0" CornerRadius="8">
        <Panel>
          <TextBlock Text="Advertisement" Classes="label" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !AdHasImage}" />
          <Button Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding OpenAdCommand}" IsVisible="{Binding AdHasImage}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
            <Image Source="{Binding AdImage}" Stretch="Uniform" MaxHeight="62" />
          </Button>
        </Panel>
      </Border>
    </Grid>
  </Grid>
</Window>
