<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels" xmlns:svc="using:Cyanlabs.Syn3Updater.App.Services" xmlns:ctl="using:Cyanlabs.Syn3Updater.App.Controls"
        x:Class="Cyanlabs.Syn3Updater.App.Views.MainWindow"
        Title="{Binding WindowTitle}" Icon="avares://Syn3Updater/Assets/logo.png" Width="1000" Height="780" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="NavItem" DataType="vm:PageViewModel">
      <Button Classes="nav" Classes.active="{Binding IsActive}" ToolTip.Tip="{Binding Title}" IsVisible="{Binding IsNavVisible}"
              Command="{Binding $parent[Window].DataContext.NavigateCommand}" CommandParameter="{Binding}">
        <Grid ColumnDefinitions="48,*">
          <PathIcon Data="{Binding IconData}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                     IsVisible="{Binding $parent[Window].DataContext.SidebarExpanded}" />
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Panel>
  <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding !Dialog.HasDialog}">
    <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0"
            Width="{Binding SidebarWidth}">
      <DockPanel Margin="0,14,0,12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="16,0,8,18">
          <Image Source="avares://Syn3Updater/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <StackPanel IsVisible="{Binding SidebarExpanded}" VerticalAlignment="Center">
            <TextBlock Text="Syn3 Updater" FontWeight="SemiBold" />
            <TextBlock Text="CyanLabs" Classes="label" />
          </StackPanel>
        </StackPanel>
        <!-- profile switcher: pick, add or delete a profile without a page of its own -->
        <Border DockPanel.Dock="Bottom" Classes="profileBar" Margin="8,8,8,0" Background="{DynamicResource BrandSoft}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10">
          <StackPanel>
        <StackPanel Margin="12,10,12,10" Spacing="6" IsVisible="{Binding SidebarExpanded}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{svc:T Home.Profile}" Classes="label" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="help" Command="{Binding AddProfileCommand}" ToolTip.Tip="{svc:T App.AddProfile}"><PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" /></Button>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="34" FontSize="13" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Classes="help danger" Command="{Binding DeleteProfileCommand}" IsVisible="{Binding CanDeleteProfile}" ToolTip.Tip="{svc:T App.DeleteProfile}"><PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" /></Button>
          </Grid>
        </StackPanel>
        <Button Classes="nav" Margin="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding !SidebarExpanded}" ToolTip.Tip="{svc:T Home.Profile}">
          <Button.Flyout>
            <Flyout Placement="RightEdgeAlignedBottom">
              <StackPanel Width="230" Spacing="8">
                <TextBlock Text="{svc:T Home.Profile}" Classes="label" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Command="{Binding AddProfileCommand}" Content="{svc:T App.AddProfile}" />
                  <Button Command="{Binding DeleteProfileCommand}" IsVisible="{Binding CanDeleteProfile}"><PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="16" Height="16" /></Button>
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <Grid><PathIcon Data="M18.92,6.01C18.72,5.42 18.16,5 17.5,5H6.5C5.84,5 5.29,5.42 5.08,6.01L3,12V20A1,1 0 0,0 4,21H5A1,1 0 0,0 6,20V19H18V20A1,1 0 0,0 19,21H20A1,1 0 0,0 21,20V12L18.92,6.01M6.5,16A1.5,1.5 0 0,1 5,14.5A1.5,1.5 0 0,1 6.5,13A1.5,1.5 0 0,1 8,14.5A1.5,1.5 0 0,1 6.5,16M17.5,16A1.5,1.5 0 0,1 16,14.5A1.5,1.5 0 0,1 17.5,13A1.5,1.5 0 0,1 19,14.5A1.5,1.5 0 0,1 17.5,16M5,11L6.5,6.5H17.5L19,11H5Z" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
        </Button>
          </StackPanel>
        </Border>
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding BottomPages}" ItemTemplate="{StaticResource NavItem}" />
        <ItemsControl ItemsSource="{Binding TopPages}" ItemTemplate="{StaticResource NavItem}" />
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0">
        <!-- the CyanLabs servers cannot be reached: shown until a request gets through again (it also retries every 30 seconds) -->
        <Border x:Name="OfflineBanner" IsVisible="{Binding Offline}" Classes="banner error" Margin="24,12,24,0">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <PathIcon Data="M23.64,7C23.64,7 23.64,7 23.64,7C20.64,3.5 16.5,1.5 12,1.5C7.5,1.5 3.36,3.5 0.36,7L12,21.5L23.64,7M19.94,8.6L12,18.5L4.06,8.6C6.38,6.2 9.14,5 12,5C14.86,5 17.62,6.2 19.94,8.6M3.27,2L2,3.27L4.27,5.54C2.7,6.24 1.3,7.25 0.15,8.5L12,23.5L16.8,17.5L20.73,21.43L22,20.16L3.27,2Z" Foreground="{DynamicResource ErrFg}" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding OfflineText}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ErrFg}" />
            <Button Grid.Column="2" Classes="accent" Content="{svc:T App.NoConnectionRetry}" Command="{Binding RetryConnectionCommand}" />
            <Button Grid.Column="3" Content="{svc:T Home.OpenStatusPage}" Command="{Binding OpenStatusPageCommand}" />
          </Grid>
        </Border>
        <!-- a newer release exists: a notice only, nothing is downloaded or installed -->
        <Border IsVisible="{Binding UpdateAvailable}" Classes="banner" Margin="24,12,24,0">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="accent" Content="{svc:T App.UpdateView}" Command="{Binding OpenUpdateCommand}" />
            <Button Grid.Column="2" Content="{svc:T App.UpdateDismiss}" Command="{Binding DismissUpdateCommand}" />
          </Grid>
        </Border>
      </StackPanel>
      <ContentControl Grid.Row="1" Content="{Binding Current}" />

      <!-- Ad space: sponsor banner image + link (Settings > Sponsor banner), or a placeholder -->
      <Border Grid.Row="2" IsVisible="{Binding AdVisible}" Margin="32,0,32,12" Height="64" MaxWidth="728" HorizontalAlignment="Stretch"
              Classes="card" Padding="0" CornerRadius="8">
        <Panel>
          <TextBlock Text="{svc:T App.Advertisement}" Classes="label" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !AdHasImage}" />
          <Button Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding OpenAdCommand}" IsVisible="{Binding AdHasImage}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
            <Image Source="{Binding AdImage}" Stretch="Uniform" MaxHeight="62" />
          </Button>
        </Panel>
      </Border>
    </Grid>
  </Grid>

    <!-- in-window dialogs: no separate OS windows, so the desktop never moves focus or the pointer -->
    <Border IsVisible="{Binding Dialog.HasDialog}" Background="#b0000000" ZIndex="100">
      <Border Classes="card" MinWidth="360" MaxWidth="600" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16" DataContext="{Binding Dialog.Current}">
          <Image Source="avares://Syn3Updater/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Left" IsVisible="{Binding ShowLogo}" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="{Binding Title}" Classes="section" FontSize="20" Classes.dlgerr="{Binding IsError}" Classes.dlgwarn="{Binding IsWarning}" TextWrapping="Wrap" />
          <ScrollViewer MaxHeight="430" HorizontalScrollBarVisibility="Disabled">
            <Panel>
              <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding UsePlainText}" />
              <ctl:MarkdownText Text="{Binding Message}" FontSize="14" IsVisible="{Binding UseMarkdown}" />
            </Panel>
          </ScrollViewer>
          <TextBox x:Name="PromptBox" Text="{Binding Text}" IsVisible="{Binding IsPrompt}" AcceptsReturn="{Binding Multiline}" TextWrapping="Wrap" MinHeight="{Binding PromptMinHeight}" MaxHeight="240" />
          <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="svc:DialogButton">
                <Button Content="{Binding Label}" MinWidth="90" HorizontalContentAlignment="Center" Classes.accent="{Binding IsPrimary}"
                        Command="{Binding $parent[Window].DataContext.Dialog.ChooseCommand}" CommandParameter="{Binding Index}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
