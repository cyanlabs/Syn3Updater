<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels"
        x:Class="Cyanlabs.Syn3Updater.App.Views.MainWindow"
        Title="{Binding WindowTitle}" Width="1000" Height="760" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="56,*">
    <!-- slim teal icon sidebar, Settings pinned to the bottom -->
    <Border Grid.Column="0" Background="#2b9aa3">
      <DockPanel>
        <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Classes="nav" ToolTip.Tip="Settings" Click="OnNavClick">
          <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
        </Button>
        <ItemsControl ItemsSource="{Binding TopPages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PageViewModel">
              <Button Classes="nav" ToolTip.Tip="{Binding Title}" Click="OnNavClick">
                <PathIcon Data="{Binding IconData}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="*,Auto">
      <ContentControl Grid.Row="0" Content="{Binding Current}" Margin="22,14,22,8" />

      <!-- Ad space. AdSense cannot run in a desktop app, so this shows a sponsor banner image + link
           (Settings > Ad slot) or a placeholder. -->
      <Border Grid.Row="1" IsVisible="{Binding AdVisible}" Margin="22,0,22,10" MinHeight="60" MaxHeight="100"
              BorderBrush="#40808080" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Center" MaxWidth="728" Width="728">
        <Panel>
          <TextBlock Text="Advertisement" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !AdHasImage}" />
          <Button Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding OpenAdCommand}" IsVisible="{Binding AdHasImage}" HorizontalAlignment="Stretch">
            <Image Source="{Binding AdImage}" Stretch="Uniform" MaxHeight="96" />
          </Button>
        </Panel>
      </Border>
    </Grid>
  </Grid>
</Window>
