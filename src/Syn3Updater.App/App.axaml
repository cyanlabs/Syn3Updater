<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cyanlabs.Syn3Updater.App.ViewModels"
             xmlns:views="using:Cyanlabs.Syn3Updater.App.Views"
             x:Class="Cyanlabs.Syn3Updater.App.App"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:DownloadViewModel"><views:DownloadView /></DataTemplate>
    <DataTemplate DataType="vm:UtilityViewModel"><views:UtilityView /></DataTemplate>
    <DataTemplate DataType="vm:NewsViewModel"><views:NewsView /></DataTemplate>
    <DataTemplate DataType="vm:LogsViewModel"><views:LogsView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:AboutViewModel"><views:AboutView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBg">#13171a</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBg">#0e1113</SolidColorBrush>
          <SolidColorBrush x:Key="CardBg">#1b2124</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorder">#2a3337</SolidColorBrush>
          <SolidColorBrush x:Key="ChipBg">#243035</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#93a3a9</SolidColorBrush>
          <SolidColorBrush x:Key="Brand">#2fa1ab</SolidColorBrush>
          <SolidColorBrush x:Key="BrandSoft">#262fa1ab</SolidColorBrush>
          <SolidColorBrush x:Key="WarnBg">#33f0a43c</SolidColorBrush>
          <SolidColorBrush x:Key="WarnFg">#f0b45a</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderHeaderBackground">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver">#14808080</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed">#1e808080</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrush">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderContentBackground">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderContentBorderBrush">Transparent</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBg">#f3f6f7</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBg">#ffffff</SolidColorBrush>
          <SolidColorBrush x:Key="CardBg">#ffffff</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorder">#dde4e7</SolidColorBrush>
          <SolidColorBrush x:Key="ChipBg">#e6f0f2</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#5d6d73</SolidColorBrush>
          <SolidColorBrush x:Key="Brand">#1f8a94</SolidColorBrush>
          <SolidColorBrush x:Key="BrandSoft">#1f1f8a94</SolidColorBrush>
          <SolidColorBrush x:Key="WarnBg">#26e8920a</SolidColorBrush>
          <SolidColorBrush x:Key="WarnFg">#9a5a00</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderHeaderBackground">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver">#14808080</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed">#1e808080</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrush">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderContentBackground">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderContentBorderBrush">Transparent</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#2fa1ab" RegionColor="#13171a" />
        <ColorPaletteResources x:Key="Light" Accent="#1f8a94" RegionColor="#f3f6f7" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- typography -->
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" /></Style>

    <Style Selector="TextBlock.dlgerr"><Setter Property="Foreground" Value="#ef6b62" /></Style>
    <Style Selector="TextBlock.dlgwarn"><Setter Property="Foreground" Value="#f0a43c" /></Style>

    <!-- surfaces -->
    <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource AppBg}" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource CardBg}" /><Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="20" /></Style>
    <Style Selector="Border.chip"><Setter Property="Background" Value="{DynamicResource ChipBg}" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="11,4" /><Setter Property="Margin" Value="0,0,8,8" /></Style>
    <Style Selector="Border.chip > TextBlock"><Setter Property="FontSize" Value="12.5" /></Style>
    <Style Selector="Border.badge"><Setter Property="Background" Value="{DynamicResource Brand}" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="10,3" /></Style>
    <Style Selector="Border.badge > TextBlock"><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Border.step"><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="CornerRadius" Value="13" /><Setter Property="Background" Value="{DynamicResource BrandSoft}" /></Style>
    <Style Selector="Border.step > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brand}" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Border.banner"><Setter Property="Background" Value="{DynamicResource WarnBg}" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,12" /></Style>

    <!-- controls -->
    <Style Selector="Button"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14,8" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="Button.link"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Brand}" /><Setter Property="Padding" Value="6,4" /></Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrandSoft}" /><Setter Property="Foreground" Value="{DynamicResource Brand}" /></Style>

    <!-- sidebar navigation -->
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Height" Value="44" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="8,2" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ChipBg}" /></Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrandSoft}" /></Style>
    <Style Selector="Button.nav PathIcon"><Setter Property="Width" Value="21" /><Setter Property="Height" Value="21" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="Button.nav.active PathIcon"><Setter Property="Foreground" Value="{DynamicResource Brand}" /></Style>
    <Style Selector="Button.nav TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="Button.nav.active TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brand}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>


    <!-- package tiles, callouts and colour accents -->
    <Style Selector="Button.tile"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="12" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ChipBg}" /><Setter Property="BorderBrush" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="Button.tile.selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrandSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brand}" /></Style>
    <Style Selector="Border.callout"><Setter Property="Background" Value="{DynamicResource BrandSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Brand}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="18,14" /></Style>

    <Style Selector="Border.ico"><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Width" Value="38" /><Setter Property="Height" Value="38" /><Setter Property="CornerRadius" Value="11" /></Style>
    <Style Selector="Border.ico > PathIcon"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /></Style>
    <Style Selector="Border.ico.teal"><Setter Property="Background" Value="#332fa1ab" /></Style><Style Selector="Border.ico.teal > PathIcon"><Setter Property="Foreground" Value="#2fa1ab" /></Style>
    <Style Selector="Border.ico.blue"><Setter Property="Background" Value="#334f8cff" /></Style><Style Selector="Border.ico.blue > PathIcon"><Setter Property="Foreground" Value="#4f8cff" /></Style>
    <Style Selector="Border.ico.amber"><Setter Property="Background" Value="#33f0a43c" /></Style><Style Selector="Border.ico.amber > PathIcon"><Setter Property="Foreground" Value="#f0a43c" /></Style>
    <Style Selector="Border.ico.purple"><Setter Property="Background" Value="#33a77bff" /></Style><Style Selector="Border.ico.purple > PathIcon"><Setter Property="Foreground" Value="#a77bff" /></Style>
    <Style Selector="Border.ico.pink"><Setter Property="Background" Value="#33f06fa6" /></Style><Style Selector="Border.ico.pink > PathIcon"><Setter Property="Foreground" Value="#f06fa6" /></Style>
    <Style Selector="Border.ico.green"><Setter Property="Background" Value="#334cc38a" /></Style><Style Selector="Border.ico.green > PathIcon"><Setter Property="Foreground" Value="#4cc38a" /></Style>
    <Style Selector="Border.ico.red"><Setter Property="Background" Value="#33ef6b62" /></Style><Style Selector="Border.ico.red > PathIcon"><Setter Property="Foreground" Value="#ef6b62" /></Style>
    <Style Selector="Border.ico.orange"><Setter Property="Background" Value="#33f08a3c" /></Style><Style Selector="Border.ico.orange > PathIcon"><Setter Property="Foreground" Value="#f08a3c" /></Style>

    <Style Selector="Border.ico.lime"><Setter Property="Background" Value="#339ccc3d" /></Style><Style Selector="Border.ico.lime > PathIcon"><Setter Property="Foreground" Value="#9ccc3d" /></Style>
    <Style Selector="Border.card.lime"><Setter Property="Background" Value="#149ccc3d" /><Setter Property="BorderBrush" Value="#559ccc3d" /></Style>
    <Style Selector="Button.help"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="3" /><Setter Property="CornerRadius" Value="12" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /></Style>
    <Style Selector="Button.help PathIcon"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="Button.help:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrandSoft}" /></Style>
    <Style Selector="Button.help:pointerover PathIcon"><Setter Property="Foreground" Value="{DynamicResource Brand}" /></Style>

    <!-- "Prepare USB": coloured like its tile once a drive is selected; disabled = the normal grey -->
    <Style Selector="Button.prep.teal:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#2fa1ab" /><Setter Property="Foreground" Value="#0e1417" /><Setter Property="BorderBrush" Value="#2fa1ab" /></Style>
    <Style Selector="Button.prep.teal:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#47b4be" /></Style>
    <Style Selector="Button.prep.lime:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#9ccc3d" /><Setter Property="Foreground" Value="#0e1417" /><Setter Property="BorderBrush" Value="#9ccc3d" /></Style>
    <Style Selector="Button.prep.lime:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#addb55" /></Style>
    <Style Selector="Button.prep.pink:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#f06fa6" /><Setter Property="Foreground" Value="#0e1417" /><Setter Property="BorderBrush" Value="#f06fa6" /></Style>
    <Style Selector="Button.prep.pink:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#f585b6" /></Style>
    <Style Selector="Button.prep.purple:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#a77bff" /><Setter Property="Foreground" Value="#0e1417" /><Setter Property="BorderBrush" Value="#a77bff" /></Style>
    <Style Selector="Button.prep.purple:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#b895ff" /></Style>
    <Style Selector="Button.prep.red:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#ef6b62" /><Setter Property="Foreground" Value="#0e1417" /><Setter Property="BorderBrush" Value="#ef6b62" /></Style>
    <Style Selector="Button.prep.red:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#f48078" /></Style>
    <Style Selector="Button.prep.green:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#4cc38a" /><Setter Property="Foreground" Value="#0e1417" /><Setter Property="BorderBrush" Value="#4cc38a" /></Style>
    <Style Selector="Button.prep.green:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#62d49b" /></Style>
    <Style Selector="Button.mini"><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="Border.card.teal"><Setter Property="Background" Value="#142fa1ab" /><Setter Property="BorderBrush" Value="#552fa1ab" /></Style>
    <Style Selector="Border.card.blue"><Setter Property="Background" Value="#144f8cff" /><Setter Property="BorderBrush" Value="#554f8cff" /></Style>
    <Style Selector="Border.card.amber"><Setter Property="Background" Value="#14f0a43c" /><Setter Property="BorderBrush" Value="#55f0a43c" /></Style>
    <Style Selector="Border.card.purple"><Setter Property="Background" Value="#14a77bff" /><Setter Property="BorderBrush" Value="#55a77bff" /></Style>
    <Style Selector="Border.card.pink"><Setter Property="Background" Value="#14f06fa6" /><Setter Property="BorderBrush" Value="#55f06fa6" /></Style>
    <Style Selector="Border.card.green"><Setter Property="Background" Value="#144cc38a" /><Setter Property="BorderBrush" Value="#554cc38a" /></Style>
    <Style Selector="Border.card.red"><Setter Property="Background" Value="#14ef6b62" /><Setter Property="BorderBrush" Value="#55ef6b62" /></Style>
    <Style Selector="Border.card.orange"><Setter Property="Background" Value="#14f08a3c" /><Setter Property="BorderBrush" Value="#55f08a3c" /></Style>

    <!-- queue status dot -->
    <Style Selector="Ellipse.dot"><Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" /><Setter Property="Stroke" Value="{DynamicResource Muted}" /><Setter Property="StrokeThickness" Value="2" /></Style>
    <Style Selector="Ellipse.dot.active"><Setter Property="Stroke" Value="{DynamicResource Brand}" /><Setter Property="Fill" Value="{DynamicResource BrandSoft}" /></Style>
    <Style Selector="Ellipse.dot.done"><Setter Property="Stroke" Value="{DynamicResource Brand}" /><Setter Property="Fill" Value="{DynamicResource Brand}" /></Style>
  </Application.Styles>
</Application>
