<Project Sdk="Microsoft.NET.Sdk">
	<!-- Plain netstandard2.0 so the same logic runs inside the net472 and net6 launchers and is unit-testable on any OS -->
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Cyanlabs.Launcher.Updating</RootNamespace>
		<Nullable>disable</Nullable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>
</Project>
