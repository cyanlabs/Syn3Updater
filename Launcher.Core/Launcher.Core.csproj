<Project Sdk="Microsoft.NET.Sdk">
	<!-- Plain netstandard2.0 so the same logic runs inside the net472 and net6 launchers and is unit-testable on any OS -->
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Cyanlabs.Launcher.Updating</RootNamespace>
		<Nullable>disable</Nullable>
	</PropertyGroup>
	<ItemGroup>
		<!-- keep in step with the Launcher and Syn3Updater (shared Newtonsoft.Json.dll in one folder); 12.0.3 has a known advisory, move all three to 13.x together -->
		<PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5crp-9r3c-p9vr" />
	</ItemGroup>
</Project>
